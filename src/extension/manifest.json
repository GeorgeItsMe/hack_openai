{
  "manifest_version": 3,
  "name": "Tabby",
  "version": "1.0.4",
  "description": "Calm focus, tasks and tabs. Context-aware assistance through GPT Tunnel.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "idle",
    "contextMenus",
    "scripting",
    "activeTab",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://tabby-pi.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tabby"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://tabby-pi.vercel.app http://127.0.0.1:4318 http://127.0.0.1:4319; style-src 'self'"
  },
  "short_name": "Tabby"
}
