# Only this server-side file may contain the provider key. Copy to .env.
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
# Low-cost model selected from the live GPT Tunnel catalog.
GPTUNNEL_MODEL=deepseek-v3.2
TABBY_PORT=4318
# Run npm run setup to generate a local pairing token (not a GPT Tunnel key).
TABBY_PAIR_TOKEN=
