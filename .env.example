# Only this server-side file may contain the provider key. Copy to .env.
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
# Leave empty to discover the unique GPT-6 Astra entry from your live catalog.
# Set an exact catalog ID only after explicitly choosing a model.
GPTUNNEL_MODEL=
FOCUSTAB_PORT=4318
# Run npm run setup to generate a local pairing token (not a GPT Tunnel key).
FOCUSTAB_PAIR_TOKEN=
