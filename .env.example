# Only this server-side file may contain the provider key. Copy to .env.
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
# Low-cost model selected from the live GPT Tunnel catalog.
GPTUNNEL_MODEL=deepseek-v3.2
TABBY_PORT=4318
# Run npm run setup to generate a local pairing token (not a GPT Tunnel key).
TABBY_PAIR_TOKEN=
# Optional Google Desktop OAuth client; use npm run setup:google -- /path/to/client.json.
# Credentials stay on this local server. Never put them in the extension.
GOOGLE_OAUTH_CLIENT_FILE=.local/google-client.json

# Optional Ambiguous API key. Leave empty to sign in through Connect Ambiguous.
AMBIGUOUS_API_KEY=
# Remote MCP is the default; the documented REST API is also supported.
AMBIGUOUS_TRANSPORT=mcp
